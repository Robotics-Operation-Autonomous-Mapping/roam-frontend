# Copy to .env.local (never commit .env.local).

# ── Supabase (Project Settings → API) ──
# Safe to use in the browser with Row Level Security enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only — required for Team Portal writes (members, applications, email logs, photos).
# Project Settings → API → service_role (secret). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Clerk (https://dashboard.clerk.com) ──
# Pulled via `clerk env pull` after linking the project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/portal
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/portal
# After accepting applicants (and seeding admins), lock Clerk to those emails:
#   npm run clerk:allowlist
# Portal login requires an applications row with status=accepted whose
# university_email OR personal_email matches the Clerk email (admins can be seeded).
# Admin tools (recruitment / all members / compose) require role=admin.

# ── Resend (https://resend.com/api-keys) ──
# Server-only — never prefix with NEXT_PUBLIC_
RESEND_API_KEY=re_your_api_key_here

# Optional sender (verified domain in Resend) — use quotes because of spaces:
# RESEND_FROM_EMAIL="ROAM <contact@schulichroam.com>"

# Admin email composer: verify captain@, team@, sponsorship@schulichroam.com in Resend.
# Contact form routing (lib/site.ts): Sponsorship/Partnership → sponsorship@ | Join the Team → team@ | else → contact@

# ── Cron (birthday emails) ──
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate_a_long_random_string
